      "html": "<div class=\"ds-card\"><p class=\"ds-line\">Aulas, palestras e treinamentos com <mark>todo mundo participando</mark>.</p></div>",
      "css": ".ds-card{max-width:560px;padding:32px;border-radius:16px;background:var(--card);color:var(--card-foreground);box-shadow:0 24px 48px -28px color-mix(in oklch,var(--foreground) 35%,transparent)}:host-context(.dark) .ds-card{border:1px solid var(--border);box-shadow:none}.ds-line{margin:0;font:800 2rem/1.05 var(--font-jakarta), 'Plus Jakarta Sans', ui-sans-serif, system-ui, sans-serif;letter-spacing:-.025em}.ds-line mark{background:var(--highlight);color:var(--highlight-foreground);padding:0 6px;border-radius:6px;box-decoration-break:clone;-webkit-box-decoration-break:clone}"
