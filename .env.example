# Supabase (cliente)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública do app (usada no QR Code e nos links de feedback)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Apenas no servidor — nunca prefixar com NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
# Gere com: openssl rand -base64 32
PARTICIPANT_TOKEN_SECRET=

# IA (opcional — o app funciona sem)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Fuso usado para exibir e interpretar datas das sessões
NEXT_PUBLIC_APP_TIME_ZONE=America/Sao_Paulo
