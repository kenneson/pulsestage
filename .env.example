# Supabase (cliente). A integração Supabase ↔ Vercel cria NEXT_PUBLIC_SUPABASE_ANON_KEY: também é aceita.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública do app (usada no QR Code e nos links de feedback). Na Vercel pode ficar vazia: usa o
# domínio de produção. Nunca use o endereço de um deploy (pulsestage-abc123-….vercel.app): ele pede
# login da Vercel a quem escaneia; se configurado assim, o app troca pelo domínio de produção.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Apenas no servidor — nunca prefixar com NEXT_PUBLIC_ (SUPABASE_SERVICE_ROLE_KEY, da integração, também vale)
SUPABASE_SECRET_KEY=
# Assina o cookie do participante e calcula o hash do IP (limites de abuso). 32+ caracteres.
# Gere com: openssl rand -base64 48
PARTICIPANT_TOKEN_SECRET=

# IA (opcional — o app funciona sem)
# AI_PROVIDER: groq | openai | anthropic
# AI_MODEL: opcional; vazio usa o padrão do provedor (src/lib/ai/index.ts):
#   groq: openai/gpt-oss-120b · openai: gpt-4.1-mini · anthropic: claude-sonnet-5-5
#   Provedores aposentam modelos: se aparecer "modelo não encontrado", defina um modelo atual aqui.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Fuso padrão. Cada palestrante tem o próprio fuso (Conta → Preferências; no cadastro, vem do navegador),
# usado para exibir e interpretar as datas das sessões dele. Este valor vale só quando não há fuso do
# palestrante (ex.: datas no perfil público /p/[slug]).
NEXT_PUBLIC_APP_TIME_ZONE=America/Sao_Paulo

# Convites de contato (opcional): avisa o palestrante por e-mail via Resend quando alguém o convida
# pelo perfil público. Sem estas variáveis, os convites ficam só em Painel → Convites.
# CONTACT_EMAIL_FROM precisa ser de um domínio verificado no Resend, ex.: PulseStage <convites@seudominio.com>
RESEND_API_KEY=
CONTACT_EMAIL_FROM=
